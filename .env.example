APP_ENV=development
LOG_LEVEL=INFO
API_KEY=change-me
TELEGRAM_SERVICE_KEY=change-me-telegram-service-key
SHOW_SOURCES=1
WEB_BOOTSTRAP_ADMIN_TOKEN=change-me-bootstrap-token
PREPARE_RAG_ON_STARTUP=1
AUTO_INDEX_ON_STARTUP=0

OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:3b
HF_EMBEDDING_MODEL=cointegrated/rubert-tiny2
HF_EMBEDDING_NORMALIZE=0
# Experimental query expansion. Keep disabled until frozen evaluation passes.
RAG_QUERY_REWRITE_ENABLED=0
# Defaults to LLM_MODEL when unset.
# RAG_QUERY_REWRITE_MODEL=qwen3:8b
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=8
CHROMA_COLLECTION_NAME=edu_documents
VECTOR_DB_DIR=./src/server/chrome_langchain_db
# LEXICAL_INDEX_PATH defaults to <VECTOR_DB_DIR>/lexical_index.sqlite3
DOCUMENTS_DIR=./data_and_documents
# production compose: каталог на хосте с PDF (рядом с compose.yaml), см. deployment/production/compose.yaml
DOCUMENTS_HOST_PATH=./data_and_documents
# Required only by deployment/production/compose.yaml. Use an absolute readable
# path on the deployment host; do not keep a profile path outside versioned ops.
SECCOMP_PROFILE_PATH=/absolute/path/to/security/seccomp/default.json
RAG_TOP_K=4
RAG_CANDIDATE_POOL_SIZE=16
RAG_RRF_K=60
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MAX_CONTEXT_DOCUMENTS=4
RAG_MAX_DOCUMENT_CHARS=1200
RAG_MAX_TOTAL_CONTEXT_CHARS=3600
RAG_MAX_HISTORY_MESSAGES=5
RAG_MAX_HISTORY_CHARS=1600
RAG_SOURCE_SNIPPET_CHARS=320
RAG_TOTAL_TIMEOUT_SECONDS=420
LLM_TIMEOUT_SECONDS=360
BOT_API_TIMEOUT_SECONDS=480
# HTTP timeout Streamlit → /ask (должен быть ≥ RAG_TOTAL + сеть)
CLIENT_ASK_TIMEOUT_SECONDS=480
CONVERSATION_MEMORY_WINDOW=5
CONVERSATION_MEMORY_TTL_SECONDS=3600
CONVERSATION_MEMORY_MAX_SESSIONS=10000

API_BASE_URL=http://localhost:8000
BOT_TOKEN=replace-with-real-token

POSTGRES_DB=edu_assistant
POSTGRES_USER=edu_assistant
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://edu_assistant:change-me@db:5432/edu_assistant
